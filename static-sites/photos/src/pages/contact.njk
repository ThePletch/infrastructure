{% extends "templates/layout.njk" %}
{% set active = "contact" %}
{% set pageTitle = "Contact" %}

{% block content %}
    <main class="page">
      <p>
        if you run a coffee shop, book store, etc and want to display my art, get in touch
      </p>
      <p>
        i don't charge, you just have to include a price tag for the print you display and a QR code linking to this website
      </p>
      <p>
        and you gotta give me the money if someone buys it i guess, don't just keep it that'd be pretty rude
      </p>
      <button type="button" class="email-reveal" id="show-email">click to see my email if you're not a robot or whatever</button>
    </main>
    <script>
      document.getElementById("show-email").addEventListener("click", (event) => {
        const addr = "phot" + "os@sha" + "y.zone";
        const link = document.createElement("a");
        link.href = "mailto:" + addr;
        link.textContent = addr;
        event.currentTarget.replaceWith(link);
      });
    </script>
{%- endblock %}
